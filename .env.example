# Endpoint tick harus memakai secret yang sama dengan secret scheduler.
CRON_SECRET=

# Wajib untuk penyimpanan persisten di Vercel. Jangan masukkan kredensial ke Git.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_KEY_PREFIX=azza-indodax

# Universe dan awal periode forward test sesuai strategi yang dibekukan.
INDODAX_UNIVERSE=BTCIDR,ETHIDR,XRPIDR
INDODAX_ALL_IN_TAKER_BUY_FEE_RATE=0.0020555
INDODAX_ALL_IN_TAKER_SELL_FEE_RATE=0.0041555
FORWARD_START_AT=

# Kill switch awal; perubahan saat berjalan dilakukan lewat /api/kill-switch.
KILL_SWITCH=false
